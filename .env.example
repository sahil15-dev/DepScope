# Set these values in your shell. DepScope does not load .env files automatically.
DEPSCOPE_DB_PATH=data/depscope.sqlite3
DEPSCOPE_MAX_FILE_BYTES=1000000
DEPSCOPE_MAX_PENDING_JOBS=4
DEPSCOPE_SUBMISSIONS_PER_MINUTE=30
DEPSCOPE_UPLOAD_TIMEOUT=10
DEPSCOPE_JOB_TIMEOUT=60
# Optional comma-separated loopback origins, such as http://localhost:5173.
DEPSCOPE_ALLOWED_ORIGINS=
